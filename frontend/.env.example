# Optional. Base URL the browser uses to reach the backend.
# Default is "/api" (proxied by the Vite dev server to the FastAPI service).
# NEVER put secrets in VITE_* variables: they are bundled into public JS.
# VITE_API_BASE_URL=/api

# Dev-server proxy target (read by vite.config.ts, not exposed to the browser).
# VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
